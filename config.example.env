# Copy to .env and edit locally. Do not commit .env.
#
# Only the first two settings are required. Everything below has a working
# default; change one only when the matching README section tells you to.

# The one Telegram chat id allowed to reach this machine. There is no default
# on purpose - the bridge refuses to start until you set your own.
GRB_CHAT_ID=123456789
GRB_TOKEN_FILE="$HOME/.config/grok-telegram-bridge/token.json"

GRB_STATE_DIR="$HOME/.grok-telegram-bridge/state"

# Path to the grok binary, if it is not on your PATH.
GRB_GROK_BIN=grok
# Seconds to wait for one turn before giving up.
GRB_GROK_TIMEOUT=180

# Which lane drives Grok: headless (one `grok -p` per message) or tui (a
# long-lived Grok session inside tmux). See "Two Lanes" in README.md.
GRB_CHAT_LANE=headless

# TUI lane only. Ignored while GRB_CHAT_LANE=headless.
GRB_TMUX_BIN=tmux
GRB_TMUX_SOCKET=grok
GRB_TMUX_SESSION=grok
# Seconds to wait for the TUI session to produce an answer.
GRB_TUI_ANSWER_TIMEOUT=180
# Fall back to the headless lane when the tmux session is gone. Off by default:
# a silent fallback hides the fact that your visible session died.
GRB_TUI_FALLBACK_HEADLESS=0

# Comma-separated tool ids to take away from Grok. Empty means no restriction.
# See "Putting the guard rails back" in README.md.
GRB_GROK_DISALLOWED_TOOLS=

# Run without calling Grok at all - useful for checking your setup.
GRB_DRY_RUN=0

# ---------------------------------------------------------------------------
# Advanced tuning (defaults shown; most setups never need to change these).

# Seconds between Telegram "typing..." refreshes while Grok works.
# GRB_TYPING_INTERVAL=4
# Where Grok keeps its session logs (read by the TUI lane).
# GRB_GROK_SESSIONS_DIR="$HOME/.grok/sessions"
# File-name prefix for this machine's state files.
# GRB_NAME=grok
